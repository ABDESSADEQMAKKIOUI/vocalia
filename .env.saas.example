# Environment for the SaaS stack (docker-compose.saas.yaml).
# Copy to .env.saas, replace every "replace-me" value, and start with:
#   docker compose -f docker-compose.saas.yaml --env-file .env.saas up -d --build
# The filled-in file holds this deployment's secrets. .gitignore only covers
# .env, .env.prod and .env.test, so add .env.saas to it before committing.

# Deployment flavour: "local" on a laptop / shared dev host, "production" on a server.
ENVIRONMENT=local

# Secret signing the JWTs issued by the local auth provider. Required — the api
# container refuses to start without it. Generate with: openssl rand -hex 32
OSS_JWT_SECRET=replace-me-openssl-rand-hex-32

# Public self-service signup. Keep false: on a SaaS install tenants are created
# by the platform admin, not from the login page.
ENABLE_SIGNUP=false

# Subscription quota enforcement. Set to false to run the stack with the plans
# and the dashboard visible but no blocking of calls or WhatsApp messages.
SUBSCRIPTION_ENFORCEMENT_ENABLED=true

# URL the browser uses to reach the api container (published on host port 8010).
# The API reports it through /health and the UI dials it directly, so it must
# carry the shifted port of this stack.
BACKEND_API_ENDPOINT=http://localhost:8010

# URL the browser uses to reach MinIO (published on host port 9010) for call
# recordings and other audio artifacts.
MINIO_PUBLIC_ENDPOINT=http://localhost:9010

# Canonical public origin, for an internet-facing install only. Leave empty for
# a local parallel run; when set, the two endpoints above default to it.
PUBLIC_BASE_URL=
PUBLIC_HOST=

# Postgres password of this stack. Baked into the volume on first init —
# changing it later does not re-key an existing database.
POSTGRES_PASSWORD=replace-me-postgres-password

# Redis password of this stack.
REDIS_PASSWORD=replace-me-redis-password

# MinIO root credentials; also used by the api as its S3 access key/secret.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-me-minio-password

# Number of uvicorn worker processes. Only container port 8000 is published, so
# keep this at 1 unless a proxy in front of the stack balances the extra ports.
FASTAPI_WORKERS=1

# Local image tags built from this checkout. Point them at an image you already
# built to start without rebuilding.
SAAS_API_IMAGE=dograh-api:saas
SAAS_UI_IMAGE=dograh-ui:saas

# Product telemetry sent to Dograh's PostHog.
ENABLE_TELEMETRY=false

# WhatsApp Cloud API (Meta). All four are needed for the WhatsApp channel:
# app id + Embedded Signup config id drive the Facebook Login popup, the app
# secret verifies webhook signatures, the verify token answers Meta's
# subscription handshake (you invent it). Leave empty to disable the channel.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0

# Cloudflare tunnel, only used with `--profile tunnel`. Empty token runs a quick
# tunnel with an ephemeral URL; set a token for a named tunnel and override the
# command with: CLOUDFLARED_COMMAND=tunnel run
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_COMMAND=

# External S3-compatible storage instead of the bundled MinIO. Leave
# ENABLE_AWS_S3 false to keep MinIO.
ENABLE_AWS_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=

# Host-side connection strings, used only when running repo scripts from the
# host against this stack (they are not injected into the containers, which
# reach postgres and redis by service name). Uncomment and align the passwords
# with the values above.
# DATABASE_URL=postgresql+asyncpg://postgres:replace-me-postgres-password@localhost:5442/postgres
# REDIS_URL=redis://:replace-me-redis-password@localhost:6389
